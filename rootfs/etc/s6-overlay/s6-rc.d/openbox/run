#!/command/with-contenv bash
. /usr/local/bin/chaos-env
chaos-wait-x 30 || exit 1
chaos_log display "Starting Openbox"
# Plain black root window: the browser should show the game, nothing else.
xsetroot -display "${DISPLAY}" -solid black 2>/dev/null || true
# The game is a fixed-size legacy app; screen blanking would only get in the way.
xset -display "${DISPLAY}" s off 2>/dev/null || true
chaos_as_user openbox --config-file /opt/chaos/config/openbox/rc.xml
