#!/bin/bash
# Shared environment defaults for every Chaos Overlords container service.
# Sourced (not executed) by the s6 service scripts and the helper scripts.

# --- Paths -------------------------------------------------------------------
: "${CONFIG_DIR:=/config}"
: "${GAME_DIR:=/game}"

# Where the game files are mirrored inside the Wine prefix. The game's shipped
# registry file uses C:\games\Chaos as its AppPath, so we keep that layout.
: "${GAME_WIN_DIR:=C:\\games\\Chaos}"
: "${GAME_UNIX_DIR:=${CONFIG_DIR}/wine/drive_c/games/Chaos}"

# --- Wine --------------------------------------------------------------------
: "${WINEPREFIX:=${CONFIG_DIR}/wine}"
: "${WINEARCH:=win32}"
: "${WINE_WINDOWS_VERSION:=win98}"
: "${WINE_VIRTUAL_DESKTOP:=true}"
# Wine shows a modal dialog only when its template already carries WS_VISIBLE,
# and three of this game's dialogs -- including Host Game and Join Game -- do
# not. Without this the game sits in a modal loop over a window that was never
# mapped, which looks exactly like a hang. Patches a copy in the prefix; the
# mounted game files are never touched.
: "${PATCH_DIALOG_VISIBILITY:=true}"

# --- Display -----------------------------------------------------------------
: "${DISPLAY:=:0}"
: "${DISPLAY_WIDTH:=640}"
: "${DISPLAY_HEIGHT:=480}"
: "${DISPLAY_DEPTH:=24}"

# --- Audio -------------------------------------------------------------------
: "${ENABLE_AUDIO:=true}"
: "${PULSE_SINK_NAME:=chaos-out}"
: "${PULSE_RUNTIME_PATH:=/run/pulse}"
: "${PULSE_SERVER:=unix:${PULSE_RUNTIME_PATH}/native}"

# --- Browser streaming (Selkies) ---------------------------------------------
: "${ENABLE_SELKIES:=true}"
: "${WEB_PORT:=8080}"
# HTTPS is on by default, on a self-signed certificate Selkies writes itself.
# This is not about eavesdropping: the browser client requires a secure context
# to run at all, and only "localhost" qualifies over plain HTTP. Served over
# HTTP on any other address -- a LAN IP, a hostname -- the page loads and then
# refuses with "secure connection is required".
# Set ENABLE_HTTPS=false when a reverse proxy terminates TLS in front.
: "${ENABLE_HTTPS:=true}"
# Basic auth is off until a password is set. Selkies itself refuses to start
# with auth enabled and no password, so this is an explicit either/or.
: "${WEB_USER:=player}"
: "${WEB_PASSWORD:=}"
# URL prefix when reverse-proxied under a subpath (e.g. "/chaos1").
: "${WEB_SUBFOLDER:=}"

# Video: the game is 2D and mostly static, so 30 fps and a modest bitrate are
# ample (SPEC sections 35 and 37). h264enc | h264enc-striped | jpeg.
#
# h264enc, which is where this started and where it has returned to twice.
# The two alternatives both looked better on a measurement and were worse in
# a player's hands:
#
#   h264enc + 4:4:4 chroma  sharper, and Firefox and Brave refuse the session
#                           outright -- they have no 4:4:4 decoder and do not
#                           fall back. See docs/video-findings.md.
#   jpeg                    needs no decoder at all and measured sharpest, but
#                           Selkies' jpeg_quality starts at 40 and only reaches
#                           the paint-over quality (90) once a screen has been
#                           still for a moment. Everything in motion is a
#                           quality-40 JPEG, which is visibly blocky.
#
# Anything changed here has to be looked at in Chrome AND Firefox, in motion
# and at rest, before it ships.
: "${VIDEO_ENCODER:=h264enc}"
: "${VIDEO_FPS:=30}"
: "${VIDEO_BITRATE:=2000}"
# 4:4:4 chroma, and OFF, because turning it on breaks whole browsers.
#
# It only applies to the H.264 encoders, and it is not the graceful negotiation
# its documentation promises: Firefox does not quietly fall back, it refuses
# the session outright with "This session streams video in a format this
# browser cannot decode." Brave the same. Chrome, which has the 4:4:4 profile,
# is fine -- which is exactly how it reaches you, as "it only breaks in some
# browsers". Leave this off unless every player is on Chrome.
#
# The problem it was meant to solve -- 4:2:0 averaging away the game's
# two-pixel coloured marks -- is solved by the jpeg encoder above instead,
# which has no chroma subsampling to lose them to. See docs/video-findings.md.
: "${VIDEO_FULLCOLOR:=false}"

# Opus, in bits per second (SPEC section 36 asks for 64-128 kbps).
: "${AUDIO_BITRATE:=96000}"

# --- CPU ---------------------------------------------------------------------
# The game's message loop peeks for a message and, finding none, yields --
# 10,500 times a second, which pins a core to no purpose. launch-game.sh
# preloads a shim that sleeps this long instead of yielding; see
# src/yieldsleep.c for the measurements. 0 disables it, restoring the original
# spin. Anything up to a few milliseconds is imperceptible in a turn-based game.
: "${WINE_YIELD_SLEEP_US:=500}"

# --- Diagnostics -------------------------------------------------------------
# Raw VNC, superseded by Selkies. Kept for debugging the X session directly.
: "${ENABLE_VNC:=false}"
: "${VNC_PORT:=5900}"

# --- Behaviour ---------------------------------------------------------------
: "${DEBUG:=false}"
: "${GAME_RESTART_DELAY:=2}"
: "${GAME_MAX_RESTARTS:=5}"
: "${APP_USER:=chaos}"
: "${APP_GROUP:=chaos}"
: "${TZ:=America/Chicago}"

if [ "${DEBUG}" = "true" ]; then
    : "${WINEDEBUG:=+warn,+err}"
else
    : "${WINEDEBUG:=-all}"
fi

# Stop Wine from trying to download Mono/Gecko on first boot.
: "${WINEDLLOVERRIDES:=mscoree,mshtml=}"

# The GOG release ships its own winmm.dll: a shim that answers the game's MCI
# "cdaudio" calls by playing MUSIC/TrackNN.ogg through the libvorbis DLLs beside
# it. That is the whole soundtrack, which is otherwise Red Book audio on a disc
# the container has no drive for.
#
# Wine loads its builtin winmm unless told otherwise, so without this the shim
# sits unused next to the game and there is simply no music. Detected from the
# files rather than configured, because a copy that has it always wants it and
# one that does not has nothing to override.
if [ -z "${WINEDLLOVERRIDES##*winmm*}" ]; then
    :   # the operator already said something about winmm; leave it alone
elif [ -n "$(find "${GAME_DIR}" -maxdepth 1 -iname 'winmm.dll' -print -quit 2>/dev/null)" ]; then
    WINEDLLOVERRIDES="${WINEDLLOVERRIDES};winmm=n,b"
fi

export CONFIG_DIR GAME_DIR GAME_WIN_DIR GAME_UNIX_DIR
export WINEPREFIX WINEARCH WINE_WINDOWS_VERSION WINE_VIRTUAL_DESKTOP
export PATCH_DIALOG_VISIBILITY
export DISPLAY DISPLAY_WIDTH DISPLAY_HEIGHT DISPLAY_DEPTH
export ENABLE_AUDIO PULSE_SINK_NAME PULSE_RUNTIME_PATH PULSE_SERVER
export ENABLE_SELKIES WEB_PORT ENABLE_HTTPS WEB_USER WEB_PASSWORD WEB_SUBFOLDER
export VIDEO_ENCODER VIDEO_FPS VIDEO_BITRATE VIDEO_FULLCOLOR AUDIO_BITRATE
export ENABLE_VNC VNC_PORT
export DEBUG GAME_RESTART_DELAY GAME_MAX_RESTARTS APP_USER APP_GROUP TZ
export WINE_YIELD_SLEEP_US
export WINEDEBUG WINEDLLOVERRIDES

# --- Logging -----------------------------------------------------------------
# Every stage prints "[stage] message" so `docker logs` reads as a timeline.
chaos_log() { echo "[$1] ${*:2}"; }
chaos_err() { echo "[$1] ERROR: ${*:2}" >&2; }
chaos_debug() { [ "${DEBUG}" = "true" ] && echo "[$1] debug: ${*:2}"; return 0; }

# --- Game executable discovery ----------------------------------------------
# GAME_EXE may be unset; in that case pick the most plausible .exe in GAME_DIR
# rather than hard-coding a filename (the retail release ships several names).
chaos_find_game_exe() {
    local candidate
    if [ -n "${GAME_EXE:-}" ]; then
        printf '%s' "${GAME_EXE}"
        return 0
    fi
    candidate=$(find "${GAME_DIR}" -maxdepth 1 -type f -iname '*chaos*.exe' 2>/dev/null | sort | head -n1)
    if [ -z "${candidate}" ]; then
        candidate=$(find "${GAME_DIR}" -maxdepth 1 -type f -iname '*.exe' 2>/dev/null | sort | head -n1)
    fi
    printf '%s' "${candidate}"
}

# Run a command as the unprivileged app user. When the container is already
# running unprivileged (hardened compose sets `user:`), just run it directly.
chaos_as_user() {
    if [ "$(id -u)" = "0" ]; then
        exec s6-setuidgid "${APP_USER}" "$@"
    fi
    exec "$@"
}
