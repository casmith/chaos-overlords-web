<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Openbox configuration for the Chaos Overlords container.

  Goals (SPEC section 33): the browser should show the game and nothing else.
  No panels, no desktop menu, no window decorations, no keybindings that could
  swallow input the game wants. Openbox is here purely so that Wine's dialogs
  and the virtual desktop window get mapped and focused correctly.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <resistance>
    <strength>0</strength>
    <screen_edge_strength>0</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names><name>Chaos</name></names>
    <popupTime>0</popupTime>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>

  <!-- No menus at all: a right click belongs to the game, not to Openbox. -->
  <menu>
    <hideDelay>0</hideDelay>
    <showIcons>no</showIcons>
  </menu>

  <!-- No keybindings: every keystroke must reach Chaos Overlords. -->
  <keyboard>
    <chainQuitKey></chainQuitKey>
  </keyboard>

  <!-- No mouse bindings on the desktop or frame; the game owns the pointer. -->
  <mouse>
    <dragThreshold>1</dragThreshold>
    <doubleClickTime>200</doubleClickTime>
    <screenEdgeWarpTime>0</screenEdgeWarpTime>
  </mouse>

  <applications>
    <!--
      Wine's virtual desktop window (and any Wine error dialog) gets no
      decorations and is pinned to the top-left corner, so the streamed image
      is exactly the game surface.
    -->
    <application class="*">
      <decor>no</decor>
      <shade>no</shade>
      <maximized>no</maximized>
      <desktop>1</desktop>
      <layer>normal</layer>
    </application>
    <application name="explorer.exe" class="Wine">
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
      <focus>yes</focus>
    </application>
  </applications>

</openbox_config>
