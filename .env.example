# Copy to .env and edit. Compose reads this file automatically.

# --- Game files --------------------------------------------------------------
# Host directory holding your installed Chaos Overlords files. It is mounted
# read-only at /game inside every container. Never commit these files.
GAME_PATH=./chaos

# Path to the executable *inside the container*. Leave unset to auto-detect the
# most plausible .exe in /game.
GAME_EXE=/game/Chaos Overlords.exe
GAME_ARGS=

# --- Display -----------------------------------------------------------------
# Chaos Overlords is a fixed 640x480 title and Wine's virtual desktop resizes to
# match it, so 640x480 frames the game exactly with no wasted pixels. Raise it
# if you want room around the game for Wine dialogs.
DISPLAY_WIDTH=640
DISPLAY_HEIGHT=480
DISPLAY_DEPTH=24

# --- Wine --------------------------------------------------------------------
WINEPREFIX=/config/wine
WINEARCH=win32
# win95 | win98 | win2k | winxp
WINE_WINDOWS_VERSION=win98
# Run the game inside a Wine virtual desktop so it cannot change the real
# screen mode out from under the streaming session.
WINE_VIRTUAL_DESKTOP=true

# Patch a copy of the game executable inside the Wine prefix so Wine displays
# its modal dialogs. Without this, Host Game and Join Game appear to hang: Wine
# only shows a modal dialog whose template already has WS_VISIBLE, and this
# game's do not. Your mounted game files are never modified.
PATCH_DIALOG_VISIBILITY=true

# --- Audio -------------------------------------------------------------------
ENABLE_AUDIO=true

# --- Browser streaming -------------------------------------------------------
# Host ports for each player's browser session. Video, audio, mouse and
# keyboard all ride this one port.
CHAOS1_WEB_PORT=8081
CHAOS2_WEB_PORT=8082

# Leave WEB_PASSWORD empty to serve without a login (trusted network only).
# Set it to turn on basic authentication for WEB_USER.
WEB_USER=player
WEB_PASSWORD=

# HTTPS on a self-signed certificate, which the container writes itself. Needed
# for more than privacy: the browser client requires a secure context, and plain
# HTTP only counts as one on localhost. Set false when a reverse proxy
# terminates TLS in front of the container.
ENABLE_HTTPS=true

# h264enc (default) | h264enc-striped | jpeg
VIDEO_ENCODER=h264enc
# 30 is plenty for this game; 15 for a low-bandwidth link.
VIDEO_FPS=30
# kilobits per second
VIDEO_BITRATE=2000
# Opus, bits per second
AUDIO_BITRATE=96000

# --- Diagnostics -------------------------------------------------------------
# Raw VNC on 5900, for debugging the X session directly. Superseded by the
# browser stream; off by default.
ENABLE_VNC=false

# --- Misc --------------------------------------------------------------------
TZ=America/Chicago
DEBUG=false

# Match the uid/gid that owns bind-mounted config directories, if you use them.
# PUID=1000
# PGID=1000

# =============================================================================
# On-demand sessions (docker-compose.manager.yml)
#
# The manager creates a container per player, gives each its own random
# password, proxies browsers to them, and reaps them when nobody is watching.
# Sessions publish no ports; the manager is the only way in.
# =============================================================================

# Port the manager listens on. Put your reverse proxy in front of this and
# terminate TLS there; nothing else needs publishing.
MANAGER_PORT=8000

# ABSOLUTE host path to the game files. The Docker daemon resolves this on the
# host, so a relative path will not work here (unlike GAME_PATH above).
GAME_PATH_ABS=/home/you/chaos-overlords-container/chaos

# Login for the session-management page. Full control: every session, delete.
ADMIN_USER=admin
ADMIN_PASSWORD=

# A second, shared password to hand to players. They sign in with a name of
# their choosing plus this password, start their own session, and see only
# their own; only the admin can touch anyone else's. Leave empty to keep
# session creation admin-only.
INVITE_PASSWORD=
MAX_SESSIONS_PER_GUEST=2

# Shown to players as the base of their link, e.g. https://chaos.example.com
PUBLIC_URL=

# Extra browser origins allowed to reach a session, comma separated. Same-origin
# is always allowed; you only need this if the page is embedded elsewhere.
# ALLOWED_ORIGINS=

# Lifecycle.
MAX_SESSIONS=6
IDLE_MINUTES=30
# 0 keeps saves indefinitely: a stopped session is removed only when you say so.
# Set a number of hours to have them swept automatically instead. Each session's
# volume is roughly 650 MB, so indefinite retention is a disk commitment.
RETENTION_HOURS=0

# Per-session resource caps.
SESSION_MEM_LIMIT=1g
SESSION_CPU_LIMIT=2

# Extra environment for every session container, comma separated:
# SESSION_ENV=VIDEO_FPS=30,WINE_WINDOWS_VERSION=win98
SESSION_ENV=
